# Copy to .credentials next to webhook.sh on the deploy host and fill in real values.
# Never commit the populated file (see .gitignore).
CI_DEPLOY_USER="<registry-user>"
CI_DEPLOY_PASSWORD="<registry-token>"
REGISTRY_HOST="<container-registry-host>"
SLACK_HOOK_URL="<slack-incoming-webhook-url>"
APP_URL="<app-url>"
