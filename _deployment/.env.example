# Copy to `.env` next to webhook.sh on the production host.
# Holds ONLY the deployed image tags: every application secret comes from
# Bitwarden Secrets Manager via `bws run` (see .credentials).
#
# webhook.sh writes these itself after a successful deploy, and rolls them back
# when a deploy fails its health check. Seed them once at setup.
BACKEND_TAG=latest
NUXT_TAG=latest
